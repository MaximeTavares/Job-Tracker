# Requis en mode 2-terminaux (npm run dashboard:dev + npm run dev ici) :
# frontend et API sur des origines différentes. Copier en .env.local.
# Avec `npm run app` (lanceur unique, même origine), laisser VITE_API_URL
# non défini : le fallback relatif dans src/api/client.ts suffit.
VITE_API_URL=http://localhost:3001
