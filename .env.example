# Base MySQL (Prisma 7 via driver adapter mariadb) — identifiants par défaut
# de docker-compose.yml (`docker compose up -d`)
DATABASE_URL="mysql://root:changeme@localhost:3307/job_tracker"

# OAuth2 Gmail — client "Web application" de Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# API Claude (Anthropic)
ANTHROPIC_API_KEY=
CLASSIFICATION_MODEL=claude-haiku-4-5

# Webhook Discord pour le résumé de run (optionnel : sans lui, résumé loggé seulement)
DISCORD_WEBHOOK_URL=

# Serveur HTTP du dashboard (local uniquement, pas d'auth) — npm run dashboard:dev
DASHBOARD_PORT=3001
